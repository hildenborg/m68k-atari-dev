m68k: Reject moves where the auto-inc source register is in the destination

At -O2, late-combine can create insns like this:

  [a0 + d0] = [a0++]

In RTL, the destination uses the original value of a0. But the move patterns
output it as "move (%a0)+,(%a0,%d0.l)", where the CPU uses the updated value.
Seen with GCC 16.1.0 and 16.2.0.
See: https://gcc.gnu.org/bugzilla/show_bug.cgi?id=123853

--- a/gcc/config/m68k/m68k-protos.h
+++ b/gcc/config/m68k/m68k-protos.h
@@ -27,6 +27,7 @@
 
 extern bool valid_mov3q_const (HOST_WIDE_INT);
 extern const char *output_move_simode (rtx *);
+extern bool m68k_move_autoinc_ok (rtx *);
 extern const char *output_move_himode (rtx *);
 extern const char *output_move_qimode (rtx *);
 extern const char *output_move_stricthi (rtx *);
--- a/gcc/config/m68k/m68k.cc
+++ b/gcc/config/m68k/m68k.cc
@@ -3286,6 +3286,26 @@
   return "move%.l %1,%0";
 }
 
+/* Return false if OPERANDS of a move insn can't be moved by the CPU, because
+   the source is auto-incremented or auto-decremented and the destination
+   address uses the same register.  RTL specifies that the destination uses
+   the original value of the register, but the CPU updates the register
+   before it calculates the destination address.  */
+
+bool
+m68k_move_autoinc_ok (rtx *operands)
+{
+  rtx src = operands[1];
+  if (!MEM_P (src) || !MEM_P (operands[0]))
+    return true;
+
+  rtx addr = XEXP (src, 0);
+  if (GET_CODE (addr) != POST_INC && GET_CODE (addr) != PRE_DEC)
+    return true;
+
+  return !reg_overlap_mentioned_p (XEXP (addr, 0), operands[0]);
+}
+
 const char *
 output_move_himode (rtx *operands)
 {
