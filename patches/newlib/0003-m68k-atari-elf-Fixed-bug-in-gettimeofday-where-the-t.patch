From 503060cabc6f046178d544a1f76347837b7cbc1a Mon Sep 17 00:00:00 2001
From: Mikael <micael@hildenborg.com>
Date: Wed, 18 Nov 2026 19:20:00 +0100
Subject: [PATCH 03/17] m68k-atari-elf: Fixed bug in gettimeofday where the
 time returned was 23 hours ahead.

---
 libgloss/m68k/atari/atari-dostime.c | 50 ++++++++++++++-
 libgloss/m68k/atari/atari-dostime.h |  8 +++
 libgloss/m68k/atari/atari-gettod.c  | 94 ++++++-----------------------
 3 files changed, 73 insertions(+), 79 deletions(-)

diff --git a/libgloss/m68k/atari/atari-dostime.c b/libgloss/m68k/atari/atari-dostime.c
index 65aeb3c66..f0e6a9807 100644
--- a/libgloss/m68k/atari/atari-dostime.c
+++ b/libgloss/m68k/atari/atari-dostime.c
@@ -9,6 +9,11 @@
 
 static const short month_to_day[] = {0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334};
 
+static int is_leap_year(int year)
+{
+	return (year % 4 == 0 && year % 100 != 0) || year % 400 == 0;
+}
+
 // Number of leap years in the range [1, year].
 static int leap_years_up_to(int year)
 {
@@ -33,10 +38,51 @@ time_t atari_dostime_to_time_t(unsigned short date, unsigned short time)
 		+ (leap_years_up_to(year - 1) - leap_years_up_to(1969))
 		+ month_to_day[month - 1]
 		+ (day - 1);
-	int is_leap = (year % 4 == 0 && year % 100 != 0) || year % 400 == 0;
-	if (is_leap && month > 2)
+	if (is_leap_year(year) && month > 2)
 	{
 		++days;
 	}
 	return days * SECONDS_IN_A_DAY + hour * 3600 + min * 60 + sec;
 }
+
+int atari_time_t_to_dostime(time_t t, unsigned short *date, unsigned short *time)
+{
+	const time_t first = atari_dostime_to_time_t((0 << 9) | (1 << 5) | 1, 0);	// 1980-01-01 00:00:00
+	const time_t last = atari_dostime_to_time_t((127 << 9) | (12 << 5) | 31, (23 << 11) | (59 << 5) | 29) + 1;	// 2107-12-31 23:59:59
+	if (t < first || t > last)
+	{
+		return -1;
+	}
+
+	int days = (int)((t - first) / SECONDS_IN_A_DAY);
+	int secs = (int)((t - first) % SECONDS_IN_A_DAY);
+
+	int year = 1980;
+	for (;;)
+	{
+		int ydays = is_leap_year(year) ? 366 : 365;
+		if (days < ydays)
+		{
+			break;
+		}
+		days -= ydays;
+		++year;
+	}
+
+	int month = 12;
+	for (int m = 1; m < 12; ++m)
+	{
+		int next = month_to_day[m] + ((is_leap_year(year) && m >= 2) ? 1 : 0);
+		if (days < next)
+		{
+			month = m;
+			break;
+		}
+	}
+	int month_start = month_to_day[month - 1] + ((is_leap_year(year) && month > 2) ? 1 : 0);
+	int day = days - month_start + 1;
+
+	*date = (unsigned short)(((year - 1980) << 9) | (month << 5) | day);
+	*time = (unsigned short)(((secs / 3600) << 11) | (((secs / 60) % 60) << 5) | ((secs % 60) >> 1));
+	return 0;
+}
diff --git a/libgloss/m68k/atari/atari-dostime.h b/libgloss/m68k/atari/atari-dostime.h
index 44e4ea2f1..313b4ec5b 100644
--- a/libgloss/m68k/atari/atari-dostime.h
+++ b/libgloss/m68k/atari/atari-dostime.h
@@ -19,6 +19,14 @@ extern "C" {
 */
 time_t atari_dostime_to_time_t(unsigned short date, unsigned short time);
 
+/*
+	Convert seconds since 1970-01-01 00:00:00 (UTC) to a GEMDOS date and time word.
+	Odd seconds are rounded down, as GEMDOS has 2 second resolution.
+	Returns 0 on success, or -1 if t is outside the GEMDOS range
+	1980-01-01 00:00:00 to 2107-12-31 23:59:59.
+*/
+int atari_time_t_to_dostime(time_t t, unsigned short *date, unsigned short *time);
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/libgloss/m68k/atari/atari-gettod.c b/libgloss/m68k/atari/atari-gettod.c
index c8227ae5e..a9896ba3f 100644
--- a/libgloss/m68k/atari/atari-gettod.c
+++ b/libgloss/m68k/atari/atari-gettod.c
@@ -7,21 +7,14 @@
 #include <time.h>
 #include "atari-gem_errno.h"
 #include "atari-traps.h"
+#include "atari-dostime.h"
 
 /*
-	Atari can only handle dates from 1980 to 2107.
-	time_t on m68k is 32bit signed, so that gives us an upper limit of 2038.
-	The code below uses that limitation to simplify the code.
+	GEMDOS keeps local time with 2 second resolution and no time zone,
+	so the clock is treated as UTC (use TZ for local time handling).
+	The GEMDOS date range is 1980-01-01 to 2107-12-31.
 */
 
-#define SEC_1970_TO_1980 315529200
-#define SEC_1970_TO_MAX 0x7fffffff
-#define SECONDS_IN_A_DAY (24 * 60 * 60)
-#define SEC_JAN_AND_FEB ((31 + 29) * SECONDS_IN_A_DAY)	// In a leap year
-#define SECONDS_IN_A_YEAR (365 * SECONDS_IN_A_DAY)
-
-static const short month_to_day[] = {0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334, 365};
-
 int gettimeofday(struct timeval* tv, void* __tz)
 {
 	struct timezone* tz = __tz;
@@ -33,33 +26,20 @@ int gettimeofday(struct timeval* tv, void* __tz)
 	}
 	if (tv != 0)
 	{
+		/*
+			Date and time are read with separate calls.
+			If the date changes in between (midnight), read again so they match.
+		*/
 		unsigned short date = trap1_2a();
 		unsigned short time = trap1_2c();
-
-		int year = ((date >> 9) & 0x7f);	// from 1980
-		int month = ((date >> 5) & 0xf) - 1;
-		int day = date & 0x1f;
-		int hour = ((time >> 11) & 0x1f);
-		int min = ((time >> 5) & 0x3f);
-		int sec = (time & 0x1f) * 2;
-
-		// Days passed in current year
-		time_t days = day + month_to_day[month];
-		// Add days for every passed year
-		days += year * 365;
-
-		// Add days for every passed leap year
-		int months = year * 12 + month;	// total months
-		months -= 2;	// remove januari and februari
-		if (months > 0)
+		unsigned short date2 = trap1_2a();
+		if (date2 != date)
 		{
-			// We must have passed at least one leap day.
-			int leap_days = (months / (12*4)) + 1;
-			days += leap_days;
+			date = date2;
+			time = trap1_2c();
 		}
 
-		// Add it all together
-		tv->tv_sec = (((((days * 24) + hour) * 60) + min) * 60) + sec + SEC_1970_TO_1980;
+		tv->tv_sec = atari_dostime_to_time_t(date, time);
 		tv->tv_usec = 0;
 	}
 	return 0;
@@ -70,55 +50,15 @@ int settimeofday(const struct timeval* tv, const struct timezone* tz)
 	// Support for timezone have been removed from linux glibc, so we just ignore it.
 	if (tv != 0)
 	{
-		if (tv->tv_sec < SEC_1970_TO_1980 || tv->tv_sec >= SEC_1970_TO_MAX)
+		unsigned short date;
+		unsigned short time;
+		if (atari_time_t_to_dostime(tv->tv_sec, &date, &time) != 0)
 		{
-			// Outside the ranges we can handle.
+			// Outside the range GEMDOS can handle.
 			gem_error_to_errno(GEM_EBADRQ);
 			return -1;
 		}
 
-		time_t seconds = tv->tv_sec - SEC_1970_TO_1980;
-		int year = 0;
-		time_t ysec = SECONDS_IN_A_YEAR;
-		do
-		{
-			ysec = SECONDS_IN_A_YEAR;
-			if ((year % 4) == 0)
-			{
-				ysec += SECONDS_IN_A_DAY;
-			}
-			++year;
-			seconds -= ysec;
-		} while (seconds >= 0);
-		--year;
-		seconds += ysec;
-
-		int minutes = seconds / 60;
-		int hours = minutes / 60;
-		int days = hours / 24;
-		int month = 0;
-		int leap = year % 4;
-		short ld = month_to_day[0];
-		for (int m = 0; m < 12; ++m)
-		{
-			short d = month_to_day[m + 1];
-			if (leap == 0 && m > 0) {d += 1;}
-			if (d > days)
-			{
-				month = m;
-				days -= ld;
-				break;
-			}
-			ld = d;
-		}
-
-		unsigned short date = (unsigned short)(year << 9);
-		date |= (unsigned short)((month + 1) << 5);
-		date |= (unsigned short)days;
-		unsigned short time = (unsigned short)((hours % 24) << 11);
-		time |= (unsigned short)((minutes % 60) << 5);
-		time |= (unsigned short)((seconds % 60) >> 1);
-
 		int err;
 		if ((err = trap1_2b(date)) < 0)
 		{
-- 
